# ================================================================
# AgentShield AI — Environment Configuration
# ================================================================

# --- Free LLM Providers ---

# 1. Google Gemini (Get free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. OpenRouter (Get free API key at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Optional Paid LLM Providers ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Vector Database / RAG (Optional) ---
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# --- Email / SMTP Configuration (Password Reset Emails) ---
# Sent from agentsheildai@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agentsheildai@gmail.com
# Set your Gmail App Password below (Generated from https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=
SMTP_FROM=agentsheildai@gmail.com
SMTP_FROM_NAME=AgenShield AI

# --- GitHub OAuth 2.0 Configuration ---
# Register OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Google OAuth 2.0 Configuration ---
# Register OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

